{
  "event_name": "add_to_cart_clicked",
  "screen_name": "Product Detail Screen",
  "trigger": "Kullan\u0131c\u0131 'Add to Cart' butonuna t\u0131klad\u0131\u011f\u0131nda tetiklenir.",
  "destinations": [
    "firebase",
    "adjust",
    "sgtm"
  ],
  "parameter_mappings": [
    {
      "target_param": "product_id",
      "source_path": "$.productId",
      "data_type": "String",
      "required": true,
      "description": "Eklenen \u00fcr\u00fcn\u00fcn ID'si"
    },
    {
      "target_param": "product_name",
      "source_path": "$.title",
      "data_type": "String",
      "required": true,
      "description": "\u00dcr\u00fcn\u00fcn ad\u0131"
    },
    {
      "target_param": "unit_price",
      "source_path": "$.price",
      "data_type": "Double",
      "required": true,
      "description": "\u00dcr\u00fcn birim fiyat\u0131"
    },
    {
      "target_param": "category",
      "source_path": "$.category",
      "data_type": "String",
      "required": false,
      "description": "\u00dcr\u00fcn kategorisi"
    }
  ]
}