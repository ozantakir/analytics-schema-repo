{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductDetailAnalyticsSchema",
  "type": "object",
  "oneOf": [
    {
      "title": "AddToCartClicked",
      "type": "object",
      "properties": {
        "eventName": {
          "type": "string",
          "const": "add_to_cart_clicked"
        },
        "productId": {
          "type": "string",
          "description": "\u00dcr\u00fcn ID bilgisi"
        },
        "price": {
          "type": "number",
          "description": "\u00dcr\u00fcn birim fiyat\u0131"
        },
        "quantity": {
          "type": "integer",
          "description": "Eklenen adet"
        },
        "category": {
          "type": "string",
          "description": "\u00dcr\u00fcn kategorisi"
        }
      },
      "required": [
        "productId",
        "price",
        "quantity"
      ]
    },
    {
      "title": "ProductView",
      "type": "object",
      "properties": {
        "eventName": {
          "type": "string",
          "const": "product_view"
        },
        "productId": {
          "type": "string",
          "description": "\u00dcr\u00fcn ID bilgisi"
        }
      },
      "required": [
        "productId"
      ]
    }
  ]
}